{
  "nameAPP": "dashboard-bff",
  "port": "8082",
  "configContainer": {
    "cpus": "1.0",
    "memory": "800m",
    "memorySwap": "1G"
  },
  "environment": [
    {
      "name": "SPRING_PROFILES_ACTIVE",
      "value": "prod"
    },
    {
      "name": "SECURITY_ENABLE",
      "value": "true"
    },
    {
      "name": "API_FATURAS_URL",
      "value": "http://fatura-services:8080/v1/fatura"
    },
    {
      "name": "API_FATURAS_RECUPERADAS_URL",
      "value": "http://fatura-services:8080/v1/fatura-recuperada"
    },
    {
      "name": "API_FATURAS_RETRY",
      "value": "3"
    },
    {
      "name": "API_FATURAS_RETRY_DURATION",
      "value": "500"
    },
    {
      "name": "PORT",
      "value": "8080"
    },
    {
      "name": "REDIS_HOST",
      "value": "redis-server"
    },
    {
      "name": "REDIS_PORT",
      "value": "6379"
    },
    {
      "name": "REDIS_PASSWORD",
      "value": "SECRET::REDIS_PASSWORD"
    },
    {
      "name": "AWS_ACCESS_KEY",
      "value": "SECRET::AWS_ACCESS_KEY"
    },
    {
      "name": "AWS_SECRET_KEY",
      "value": "SECRET::AWS_SECRET_KEY"
    },
    {
      "name": "JAVA_TOOL_OPTIONS",
      "value": "-javaagent:/app/elastic-apm-agent.jar"
    },
    {
      "name": "ELASTIC_APM_SERVICE_NAME",
      "value": "dashboard-bff"
    },
    {
      "name": "ELASTIC_APM_SERVER_URL",
      "value": "http://apm-server:8200"
    },
    {
      "name": "ELASTIC_APM_ENVIRONMENT",
      "value": "prod"
    },
    {
      "name": "ELASTIC_APM_APPLICATION_PACKAGES",
      "value": "com.caderneta"
    }
  ]
}